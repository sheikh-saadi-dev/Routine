<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#1F4D3D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icons/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<title>রুটিন — আপনার দিনের সঙ্গী</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Baloo+Da+2:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F3F1EA;
    --surface:#FFFFFF;
    --surface-2:#ECE9DE;
    --ink:#1E231F;
    --ink-soft:#5D6459;
    --ink-faint:#9A9F8F;
    --border:#E4E0D2;

    --green:#26604A;
    --green-deep:#153A2C;
    --green-tint:#E2EFE7;

    --gold:#B07E2E;
    --gold-tint:#F6ECD8;

    --blue:#33608C;
    --blue-tint:#E4EBF3;

    --rose:#A15D6C;
    --rose-tint:#F3E4E8;

    --indigo:#4C5580;
    --indigo-tint:#E7E8F1;

    --gray:#5C6169;
    --gray-tint:#EBEAE4;

    --radius-lg:22px;
    --radius-md:16px;
    --radius-sm:10px;
    --shadow:0 3px 14px rgba(21,58,44,.08);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Hind Siliguri', sans-serif;
    line-height:1.6;
    font-size:15.5px;
    min-height:100vh;
  }
  h1,h2,h3,.display{ font-family:'Baloo Da 2', 'Hind Siliguri', sans-serif; }

  /* ---------- App shell ---------- */
  .phone{
    width:100%;
    max-width:560px;
    margin:0 auto;
    background:var(--bg);
    display:flex;
    flex-direction:column;
    min-height:100vh;
    position:relative;
  }

  /* ---------- App bar ---------- */
  .appbar{
    background:linear-gradient(160deg, var(--green-deep), var(--green) 85%);
    color:#F4F2E6;
    padding:6px 22px 20px;
    flex-shrink:0;
  }
  .appbar-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-size:12.5px;
    color:#CFE1D6;
    margin-bottom:6px;
  }
  .appbar h1{
    margin:0 0 3px;
    font-size:1.5rem;
    font-weight:700;
    letter-spacing:.01em;
  }
  .appbar .appbar-sub{
    margin:0;
    font-size:.85rem;
    color:#CBDED3;
  }
  .streak-pill{
    background:rgba(255,255,255,.14);
    border-radius:100px;
    padding:4px 10px;
    font-size:11.5px;
    display:flex;
    align-items:center;
    gap:4px;
  }

  /* ---------- Scrollable screen ---------- */
  .screen{
    flex:1;
    padding:16px 16px 90px;
  }

  .panel{ display:none; animation:fadeIn .25s ease; }
  .panel.active{ display:block; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  /* ---------- Generic pieces ---------- */
  .section-label{
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.09em;
    text-transform:uppercase;
    color:var(--ink-faint);
    margin:22px 2px 10px;
  }
  .section-label:first-child{ margin-top:2px; }

  .stat-row{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
    margin-bottom:4px;
  }
  .stat-card{
    background:var(--surface);
    border-radius:var(--radius-md);
    padding:10px 6px;
    text-align:center;
    box-shadow:var(--shadow);
  }
  .stat-card .num{ font-family:'Baloo Da 2'; font-weight:700; font-size:1.05rem; color:var(--green-deep); display:block; }
  .stat-card .lbl{ font-size:10.5px; color:var(--ink-soft); }

  .progress-wrap{
    background:var(--surface);
    border-radius:var(--radius-md);
    padding:12px 14px;
    box-shadow:var(--shadow);
    margin-top:10px;
  }
  .progress-wrap .p-top{
    display:flex; justify-content:space-between; align-items:center;
    font-size:.78rem; color:var(--ink-soft); margin-bottom:7px;
  }
  .progress-wrap .p-top b{ color:var(--green-deep); font-family:'Baloo Da 2'; font-size:.95rem; }
  .progress-track{
    height:9px; border-radius:100px; background:var(--surface-2); overflow:hidden;
  }
  .progress-fill{
    height:100%; border-radius:100px;
    background:linear-gradient(90deg, var(--gold), var(--green));
    width:0%; transition:width .35s ease;
  }

  .legend{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin:14px 0 4px;
  }
  .legend button{
    font-family:inherit;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--ink-soft);
    font-size:11.5px;
    font-weight:600;
    padding:6px 11px;
    border-radius:100px;
    display:flex;
    align-items:center;
    gap:5px;
    cursor:pointer;
  }
  .legend button .dot{ width:7px; height:7px; border-radius:50%; }
  .legend button.on{ background:var(--green-deep); color:#fff; border-color:var(--green-deep); }
  .legend button.on .dot{ background:#fff !important; }

  /* ---------- Timeline (signature element) ---------- */
  .timeline{ position:relative; margin-top:14px; padding-right:2px; }
  .t-item{
    position:relative;
    display:grid;
    grid-template-columns:20px 1fr;
    gap:10px;
    padding-bottom:16px;
  }
  .t-item .rail{
    position:relative;
    display:flex;
    justify-content:center;
  }
  .t-item .rail::before{
    content:"";
    position:absolute;
    top:18px; bottom:-16px;
    width:2.5px;
    background:var(--border);
    border-radius:2px;
  }
  .t-item:last-child .rail::before{ display:none; }
  .t-item .node{
    width:13px; height:13px;
    border-radius:50%;
    background:var(--cat-color, var(--gray));
    border:3px solid var(--bg);
    box-shadow:0 0 0 1.5px var(--cat-color, var(--gray));
    margin-top:4px;
    z-index:1;
  }
  .t-item.prayer .node{ border-radius:3px; transform:rotate(45deg); width:11px; height:11px; }

  .t-card{
    background:var(--surface);
    border-radius:var(--radius-md);
    box-shadow:var(--shadow);
    padding:12px 14px;
    border-right:3px solid var(--cat-color, var(--gray));
  }
  .t-card.done{ opacity:.55; }
  .t-card.done .t-title{ text-decoration:line-through; }
  .t-card .t-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:8px;
  }
  .t-check{
    display:flex; align-items:center; gap:7px;
    flex-shrink:0;
  }
  .t-check input[type=checkbox]{
    width:19px; height:19px; accent-color:var(--cat-color, var(--green)); cursor:pointer;
  }
  .t-alarm-row{
    display:flex; align-items:center; gap:8px; margin-top:9px;
  }
  .t-alarm-row button{
    font-family:inherit; font-size:.76rem; font-weight:600;
    border:1px solid var(--border); background:var(--surface-2); color:var(--ink-soft);
    border-radius:100px; padding:5px 10px; display:flex; align-items:center; gap:4px; cursor:pointer;
  }
  .t-alarm-row button.set{ background:var(--cat-tint, var(--gray-tint)); color:var(--cat-color, var(--ink)); border-color:transparent; }
  .t-alarm-row input[type=time]{
    font-family:inherit; font-size:.78rem; border:1px solid var(--border); border-radius:8px;
    padding:4px 6px; background:var(--surface); color:var(--ink); width:90px;
  }
  .t-alarm-row svg{ width:13px; height:13px; }
  .t-time{
    font-size:11px;
    font-weight:700;
    color:var(--cat-color, var(--ink-soft));
    background:var(--cat-tint, var(--gray-tint));
    padding:3px 8px;
    border-radius:100px;
    white-space:nowrap;
  }
  .t-dur{
    font-size:10.5px;
    color:var(--ink-faint);
    font-weight:600;
    white-space:nowrap;
  }
  .t-title{
    font-weight:700;
    font-size:.98rem;
    margin:7px 0 2px;
    color:var(--ink);
  }
  .t-purpose{
    font-size:.83rem;
    color:var(--ink-soft);
    margin:0;
  }
  .t-card details{ margin-top:8px; }
  .t-card summary{
    font-size:.78rem;
    font-weight:600;
    color:var(--cat-color, var(--green));
    cursor:pointer;
    list-style:none;
    display:flex;
    align-items:center;
    gap:4px;
  }
  .t-card summary::-webkit-details-marker{ display:none; }
  .t-card summary::after{ content:"▾"; font-size:9px; transition:transform .2s; }
  .t-card details[open] summary::after{ transform:rotate(180deg); }
  .t-avoid{
    margin:8px 0 0;
    font-size:.8rem;
    color:#9A4A47;
    background:#FBEEEC;
    padding:7px 10px;
    border-radius:var(--radius-sm);
  }
  .t-avoid b{ font-weight:700; }
  .t-item[data-hide="1"]{ display:none; }

  /* ---------- Weekly tab ---------- */
  .day-picker{
    display:flex;
    gap:6px;
    overflow-x:auto;
    padding-bottom:4px;
    margin-top:10px;
  }
  .day-picker button{
    font-family:'Baloo Da 2';
    flex:0 0 auto;
    width:52px; height:58px;
    border-radius:14px;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--ink-soft);
    font-weight:700;
    font-size:.85rem;
    cursor:pointer;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
  }
  .day-picker button span{ font-size:9px; font-weight:600; font-family:'Hind Siliguri'; color:var(--ink-faint); }
  .day-picker button.on{ background:var(--green-deep); border-color:var(--green-deep); color:#fff; }
  .day-picker button.on span{ color:#CFE1D6; }
  .day-picker button.off-day{ box-shadow:inset 0 0 0 1.5px var(--gold); }

  .day-detail{
    background:var(--surface);
    border-radius:var(--radius-lg);
    padding:16px;
    margin-top:14px;
    box-shadow:var(--shadow);
  }
  .day-detail h3{ margin:0 0 10px; font-size:1.05rem; color:var(--green-deep); }
  .day-row{
    display:flex;
    gap:10px;
    align-items:flex-start;
    padding:8px 0;
    border-top:1px solid var(--border);
  }
  .day-row:first-of-type{ border-top:none; padding-top:0; }
  .day-row .ico{
    width:30px; height:30px; border-radius:9px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
    background:var(--blue-tint); color:var(--blue);
  }
  .day-row.online .ico{ background:var(--gray-tint); color:var(--gray); }
  .day-row .txt b{ display:block; font-size:.75rem; color:var(--ink-faint); font-weight:600; }
  .day-row .txt span{ font-size:.9rem; font-weight:600; }
  /* ---------- Cards / accordion ---------- */
  .card{
    background:var(--surface);
    border-radius:var(--radius-lg);
    padding:16px;
    margin-bottom:12px;
    box-shadow:var(--shadow);
  }
  .card h3{ margin:0 0 10px; font-size:1rem; color:var(--green-deep); }
  .card p{ margin:0 0 8px; font-size:.9rem; color:var(--ink-soft); }
  .card ul, .card ol{ margin:0; padding-right:18px; font-size:.88rem; color:var(--ink-soft); }
  .card li{ margin-bottom:5px; }

  .mini-table{ width:100%; border-collapse:collapse; font-size:.83rem; margin-top:6px; }
  .mini-table th, .mini-table td{ text-align:right; padding:7px 6px; border-bottom:1px solid var(--border); }
  .mini-table th{ color:var(--ink-faint); font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
  .mini-table tr:last-child td{ border-bottom:none; }

  .accordion{
    background:var(--surface);
    border-radius:var(--radius-lg);
    margin-bottom:10px;
    box-shadow:var(--shadow);
    overflow:hidden;
  }
  .accordion summary{
    list-style:none;
    cursor:pointer;
    padding:15px 16px;
    display:flex;
    align-items:center;
    gap:11px;
    font-weight:700;
    font-size:.94rem;
    color:var(--ink);
  }
  .accordion summary::-webkit-details-marker{ display:none; }
  .accordion .ico{
    width:34px; height:34px; border-radius:10px;
    background:var(--green-tint); color:var(--green-deep);
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .accordion summary .chev{ margin-right:auto; font-size:11px; color:var(--ink-faint); transition:transform .2s; }
  .accordion[open] summary .chev{ transform:rotate(180deg); }
  .accordion .acc-body{ padding:0 16px 16px; font-size:.87rem; color:var(--ink-soft); }
  .accordion .acc-body p{ margin:0 0 8px; }
  .accordion .acc-body ul, .accordion .acc-body ol{ margin:0 0 8px; padding-right:18px; }
  .accordion .acc-body li{ margin-bottom:5px; }

  .callout{
    background:var(--green-tint);
    border-radius:var(--radius-sm);
    padding:11px 13px;
    font-size:.84rem;
    color:var(--green-deep);
    margin:10px 0 0;
  }
  .callout.warn{ background:#FBEEEC; color:#8C4440; }
  .rule-chip{
    background:var(--green-deep);
    color:#EFEBDD;
    border-radius:var(--radius-sm);
    padding:10px 13px;
    font-size:.85rem;
    margin-bottom:8px;
  }
  .rule-chip b{ color:#E7C787; }

  .closing-card{
    background:var(--green-deep);
    color:#E9E6D8;
    border-radius:var(--radius-lg);
    padding:18px;
    font-size:.88rem;
    line-height:1.8;
    margin-top:6px;
  }

  /* ---------- Tracker ---------- */
  .tracker-wrap{ overflow-x:auto; border-radius:var(--radius-md); box-shadow:var(--shadow); background:var(--surface); }
  .tracker{ border-collapse:collapse; width:100%; min-width:520px; font-size:.78rem; }
  .tracker th, .tracker td{ text-align:center; padding:8px 6px; border-bottom:1px solid var(--border); }
  .tracker th{ background:var(--green-deep); color:#EFEBDD; font-size:.7rem; }
  .tracker td:first-child, .tracker th:first-child{
    text-align:right; position:sticky; right:0; background:var(--surface);
    font-weight:600; padding-right:10px; min-width:92px;
  }
  .tracker th:first-child{ background:var(--green-deep); }
  .tracker input[type=checkbox]{ width:17px; height:17px; accent-color:var(--green); }

  .note-box{
    background:var(--gold-tint);
    border-radius:var(--radius-md);
    padding:13px 15px;
    font-size:.83rem;
    color:#7A5A25;
    margin-bottom:16px;
  }
  .note-box b{ color:var(--ink); }

  /* ---------- Bottom nav ---------- */
  .bottomnav{
    position:fixed;
    left:0; right:0; bottom:0;
    max-width:560px;
    margin:0 auto;
    background:var(--surface);
    border-top:1px solid var(--border);
    display:flex;
    padding:8px 6px calc(env(safe-area-inset-bottom,0) + 8px);
    box-shadow:0 -4px 16px rgba(0,0,0,.05);
  }
  .bottomnav button{
    flex:1;
    background:none; border:none;
    display:flex; flex-direction:column; align-items:center; gap:3px;
    font-family:'Hind Siliguri';
    font-size:10.5px;
    font-weight:600;
    color:var(--ink-faint);
    padding:5px 2px;
    cursor:pointer;
    border-radius:12px;
  }
  .bottomnav button svg{ width:21px; height:21px; }
  .bottomnav button.on{ color:var(--green-deep); }
  .bottomnav button.on .icowrap{ background:var(--green-tint); }
  .bottomnav .icowrap{ padding:4px 12px; border-radius:100px; }

</style>
</head>
<body>

<div class="phone">

  <div class="appbar">
    <div class="appbar-top">
      <span id="dateLabel">শনিবার · আজ</span>
      <span style="display:flex; gap:6px; align-items:center;">
        <button id="installBtn" class="streak-pill" style="display:none; border:none; cursor:pointer; font-family:inherit;">⬇ ইনস্টল</button>
        <span class="streak-pill" id="streakPill">🔥 ৩ দিন ধারাবাহিক</span>
      </span>
    </div>
    <h1>আসসালামু আলাইকুম</h1>
    <p class="appbar-sub">নামাজকে কেন্দ্র করে সাজানো আপনার দিন</p>
  </div>

  <main class="screen">

    <!-- ===== TODAY / TIMELINE ===== -->
    <section id="tab-today" class="panel active">
      <div class="stat-row">
        <div class="stat-card"><span class="num">৫</span><span class="lbl">ওয়াক্ত নামাজ</span></div>
        <div class="stat-card"><span class="num">২–২.৫ঘ</span><span class="lbl">বিসিএস</span></div>
        <div class="stat-card"><span class="num">৬–৬.৫ঘ</span><span class="lbl">ঘুম</span></div>
        <div class="stat-card"><span class="num">≤১ঘ</span><span class="lbl">অনলাইন</span></div>
      </div>

      <div class="progress-wrap">
        <div class="p-top"><span>আজকের অগ্রগতি</span><b id="progressText">০/২১ সম্পন্ন</b></div>
        <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      </div>

      <div class="legend" id="legend">
        <button data-cat="all" class="on"><span class="dot" style="background:var(--ink-faint)"></span>সব</button>
        <button data-cat="prayer"><span class="dot" style="background:var(--green)"></span>নামাজ</button>
        <button data-cat="income"><span class="dot" style="background:var(--gold)"></span>আয়</button>
        <button data-cat="study"><span class="dot" style="background:var(--blue)"></span>বিসিএস</button>
        <button data-cat="family"><span class="dot" style="background:var(--rose)"></span>পরিবার</button>
        <button data-cat="rest"><span class="dot" style="background:var(--indigo)"></span>বিশ্রাম</button>
        <button data-cat="online"><span class="dot" style="background:var(--gray)"></span>অনলাইন</button>
      </div>

      <div class="timeline" id="timeline"><!-- injected by JS --></div>

      <div class="note-box"><b>নোট:</b> প্রতিটি কার্ডের সময় ট্যাপ করে নিজের মতো লিখে বদলাতে পারবেন (নামাজের সময় বছরজুড়ে পরিবর্তিত হয়)। "অ্যালার্ম সেট করুন" ব্রাউজার নোটিফিকেশন ব্যবহার করে — কাজ করতে অ্যাপ/ট্যাব খোলা রাখতে হবে। সত্যিকারের সিস্টেম অ্যালার্মের জন্য নেটিভ অ্যাপে Android AlarmManager দরকার হবে (নিচের প্রম্পটে বলা আছে)।</div>
    </section>

    <!-- ===== WEEKLY ===== -->
    <section id="tab-week" class="panel">
      <div class="section-label">সপ্তাহের দিন বাছাই করুন</div>
      <div class="day-picker" id="dayPicker"></div>
      <div class="day-detail" id="dayDetail"></div>

      <div class="section-label">অনলাইন কাজের নিয়ম</div>
      <div class="card">
        <ul>
          <li>সর্বোচ্চ প্রতিদিন ১ ঘণ্টা, শুধু নির্ধারিত ৫ দিনে</li>
          <li>মঙ্গল ও শুক্রবার সম্পূর্ণ অফলাইন</li>
          <li>বিসিএস ব্লক ও পড়ানো শেষ হওয়ার পরেই শুরু</li>
          <li>নির্ধারিত স্লট ছাড়া অ্যানালিটিক্স চেক নয়</li>
          <li>একদিনে একটি প্ল্যাটফর্ম, পড়ার সময় ফোন-মুক্ত</li>
        </ul>
