      <span class="icowrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 2.5 2.5L16 9"/></svg></span>
      ট্র্যাকার
    </button>
    <button data-tab="more">
      <span class="icowrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg></span>
      আরও
    </button>
  </nav>

</div>

<script>
/* ---------------- Data ---------------- */
const CAT = {
  prayer: {label:"নামাজ", color:"var(--green)", tint:"var(--green-tint)"},
  income: {label:"আয়", color:"var(--gold)", tint:"var(--gold-tint)"},
  study:  {label:"বিসিএস", color:"var(--blue)", tint:"var(--blue-tint)"},
  family: {label:"পরিবার", color:"var(--rose)", tint:"var(--rose-tint)"},
  rest:   {label:"বিশ্রাম", color:"var(--indigo)", tint:"var(--indigo-tint)"},
  online: {label:"অনলাইন", color:"var(--gray)", tint:"var(--gray-tint)"}
};

const TIMELINE = [
  {t:"ফজরের আগে", d:"১০–১৫ মি.", cat:"prayer", title:"ঘুম থেকে ওঠা, ওযু", purpose:"নামাজের প্রস্তুতি", avoid:"বারবার স্নুজ করা"},
  {t:"ফজর", d:"১০–১৫ মি.", cat:"prayer", title:"নামাজ + জিকির", purpose:"দিনের ভিত্তি", avoid:"নামাজের আগে ফোন চেক করা"},
  {t:"ফজরের পর", d:"২০–৩০ মি.", cat:"prayer", title:"কুরআন তিলাওয়াত", purpose:"দৈনিক সংযোগ", avoid:"সোশ্যাল মিডিয়া স্ক্রল"},
  {t:"সকাল", d:"২০–৩০ মি.", cat:"rest", title:"নাস্তা ও প্রস্তুতি", purpose:"শারীরিক প্রস্তুতি", avoid:"না খেয়ে তাড়াহুড়া"},
  {t:"৬:০০–৮:৩০ AM", d:"২ ঘ. ৩০ মি.", cat:"income", title:"পড়ানো (ক্লাস ৬–১০)", purpose:"নির্দিষ্ট আয়"},
  {t:"পড়ানোর পর", d:"১৫–২০ মি.", cat:"rest", title:"বিশ্রাম / হালকা নাস্তা", purpose:"পুনরুদ্ধার", avoid:"সাথে সাথে ল্যাপটপ খোলা"},
  {t:"সকালের মাঝামাঝি", d:"১–১.৫ ঘ.", cat:"study", title:"বিসিএস ব্লক #১ — গভীর পড়াশোনা", purpose:"সেরা মনোযোগের সময়", avoid:"এই সময় অন্য কাজে দেওয়া"},
  {t:"বেলা বাড়তে", d:"৩০–৪৫ মি.", cat:"online", title:"টুকিটাকি কাজ / অনলাইন স্লট", purpose:"নমনীয় বাফার", avoid:"সীমাহীন ব্রাউজিং"},
  {t:"যোহর", d:"~১৫ মি.", cat:"prayer", title:"নামাজ", purpose:"ভিত্তি"},
  {t:"যোহরের পর", d:"২০–৩০ মি.", cat:"rest", title:"খাবার + সংক্ষিপ্ত নাপ", purpose:"শারীরিক পুনরুদ্ধার", avoid:"এটি বাদ দেওয়া"},
  {t:"বিকেলের শুরু", d:"৩০–৪৫ মি.", cat:"rest", title:"ফ্রি / বাফার / হালকা এমসিকিউ", purpose:"নমনীয়তা", avoid:"ওভারলোড করা"},
  {t:"২:০০ PM–সন্ধ্যা", d:"~৩ ঘ.", cat:"income", title:"পড়ানো (ক্লাস ৬–১০)", purpose:"নির্দিষ্ট আয়"},
  {t:"আসর", d:"~১৫ মি.", cat:"prayer", title:"নামাজ", purpose:"ভিত্তি", avoid:"বাদ দেওয়া"},
  {t:"পড়ানোর পর", d:"৩০–৪৫ মি.", cat:"family", title:"পরিবারের সাথে সময়, চা", purpose:"সম্পর্ক রক্ষা", avoid:"সরাসরি স্ক্রিনে যাওয়া"},
  {t:"মাগরিব", d:"~১৫–২০ মি.", cat:"prayer", title:"নামাজ", purpose:"ভিত্তি"},
  {t:"মাগরিবের পর", d:"৪৫–৬০ মি.", cat:"study", title:"বিসিএস ব্লক #২ (রিকল/এমসিকিউ) বা পারিবারিক সময়", purpose:"দ্বিতীয় পড়ার সময়", avoid:"ঠিকমতো না খাওয়া"},
  {t:"এশা", d:"~১৫–২০ মি.", cat:"prayer", title:"নামাজ", purpose:"ভিত্তি"},
  {t:"এশার পর", d:"৩০–৪৫ মি.", cat:"family", title:"রাতের খাবার, পরিবার", purpose:"বিশ্রাম", avoid:"অফিসের আগে অনলাইন কাজ"},
  {t:"৮:৪৫ PM–১২:০০ AM", d:"~৩ ঘ. ১৫ মি.", cat:"income", title:"অফিস / চাকরি", purpose:"নির্দিষ্ট আয়"},
  {t:"মধ্যরাতের পর", d:"১৫–২০ মি.", cat:"prayer", title:"দোয়া / ইস্তেগফার, ঘুমের প্রস্তুতি", purpose:"দিন শেষ করা", avoid:"ফোন খোলা"},
  {t:"ঘুম", d:"৬–৬.৫ ঘ. (ন্যূনতম)", cat:"rest", title:"ঘুম", purpose:"পুনরুদ্ধার", avoid:"ঘুম ত্যাগ করা"}
];

const WEEK = [
  {short:"শনি", full:"শনিবার", off:false, subject:"বাংলা + সাধারণ জ্ঞান", online:"ওয়েবসাইট ১ (১ ঘণ্টা)"},
  {short:"রবি", full:"রবিবার", off:false, subject:"ইংরেজি", online:"ওয়েবসাইট ২ (১ ঘণ্টা)"},
  {short:"সোম", full:"সোমবার", off:false, subject:"গণিত + মানসিক দক্ষতা", online:"ওয়েব ডেভেলপমেন্ট (১ ঘণ্টা)"},
  {short:"মঙ্গল", full:"মঙ্গলবার", off:true, subject:"সাধারণ বিজ্ঞান + আইসিটি", online:"নেই — পুনরুদ্ধার দিন"},
  {short:"বুধ", full:"বুধবার", off:false, subject:"আন্তর্জাতিক বিষয়াবলি", online:"ওয়েবসাইট ১ (১ ঘণ্টা)"},
  {short:"বৃহ", full:"বৃহস্পতিবার", off:false, subject:"সাপ্তাহিক রিভিশন", online:"ওয়েবসাইট ২ / ডেভ (১ ঘণ্টা)"},
  {short:"শুক্র", full:"শুক্রবার", off:true, subject:"মডেল টেস্ট + এরর রিভিউ", online:"নেই"}
];

const HABITS = ["ফজর","যোহর","আসর","মাগরিব","এশা","কুরআন","বিসিএস","এমসিকিউ","টিউশন","অফিস","পরিবার","ওয়েবসাইট","হাঁটা/ব্যায়াম"];

/* ---------------- Local storage (data persists across app opens) ---------------- */
const STORE_KEY = 'routineAppState_v1';
function loadStore(){
  try{
    return JSON.parse(localStorage.getItem(STORE_KEY)) || {};
  }catch(e){ return {}; }
}
function saveStore(patch){
  const s = loadStore();
  Object.assign(s, patch);
  try{ localStorage.setItem(STORE_KEY, JSON.stringify(s)); }catch(e){}
}
const store = loadStore();
if(!store.done) store.done = {};
if(!store.times) store.times = {};
if(!store.alarms) store.alarms = {};
if(!store.tracker) store.tracker = {};

/* ---------------- Today's date (Bengali) ---------------- */
(function setDateLabel(){
  const days = ["রবিবার","সোমবার","মঙ্গলবার","বুধবার","বৃহস্পতিবার","শুক্রবার","শনিবার"];
  const label = document.getElementById('dateLabel');
  if(label) label.textContent = days[new Date().getDay()] + ' · আজ';
})();

/* ---------------- Render timeline ---------------- */
const timelineEl = document.getElementById('timeline');
TIMELINE.forEach((item, idx)=>{
  const c = CAT[item.cat];
  const el = document.createElement('div');
  el.className = 't-item' + (item.cat==='prayer' ? ' prayer' : '');
  el.dataset.cat = item.cat;
  el.style.setProperty('--cat-color', c.color);
  el.style.setProperty('--cat-tint', c.tint);
  const savedTime = store.times[idx] || item.t;
  const isDone = !!store.done[idx];
  el.innerHTML = `
    <div class="rail"><div class="node"></div></div>
    <div class="t-card${isDone ? ' done' : ''}" id="card-${idx}">
      <div class="t-top">
        <span class="t-time" contenteditable="true" spellcheck="false" title="ট্যাপ করে সময় বদলান">${savedTime}</span>
        <span class="t-check">
          <span class="t-dur">${item.d}</span>
          <input type="checkbox" class="done-box" data-idx="${idx}" title="সম্পন্ন হিসেবে চিহ্নিত করুন" ${isDone ? 'checked' : ''}>
        </span>
      </div>
      <div class="t-title">${item.title}</div>
      <p class="t-purpose">${item.purpose}</p>
      <div class="t-alarm-row">
        <input type="time" class="alarm-input" data-idx="${idx}" value="${store.alarms[idx] || ''}">
        <button class="alarm-btn${store.alarms[idx] ? ' set' : ''}" data-idx="${idx}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="13" r="7"/><path d="M12 10v3l2 1M8.5 3.5 5 6M15.5 3.5 19 6"/></svg>
          ${store.alarms[idx] ? `সেট: ${store.alarms[idx]}` : 'অ্যালার্ম সেট করুন'}
        </button>
      </div>
      ${item.avoid ? `<details><summary>বিস্তারিত</summary><p class="t-avoid"><b>যা করবেন না:</b> ${item.avoid}</p></details>` : ``}
    </div>`;
  timelineEl.appendChild(el);
});

/* ---------------- Progress tracking ---------------- */
const totalItems = TIMELINE.length;
const progressFill = document.getElementById('progressFill');
const progressText = document.getElementById('progressText');
function toBengaliDigits(n){
  const map = {'0':'০','1':'১','2':'২','3':'৩','4':'৪','5':'৫','6':'৬','7':'৭','8':'৮','9':'৯'};
  return String(n).replace(/[0-9]/g, d=>map[d]);
}
function updateProgress(){
  const done = document.querySelectorAll('.done-box:checked').length;
  const pct = Math.round((done/totalItems)*100);
  progressFill.style.width = pct + '%';
  progressText.textContent = `${toBengaliDigits(done)}/${toBengaliDigits(totalItems)} সম্পন্ন`;
}
timelineEl.addEventListener('change', e=>{
  if(e.target.classList.contains('done-box')){
    document.getElementById('card-'+e.target.dataset.idx).classList.toggle('done', e.target.checked);
    store.done[e.target.dataset.idx] = e.target.checked;
    saveStore({done: store.done});
    updateProgress();
  }
});
timelineEl.addEventListener('blur', e=>{
  if(e.target.classList.contains('t-time')){
    const card = e.target.closest('.t-card');
    const idx = card.id.replace('card-','');
    store.times[idx] = e.target.textContent.trim();
    saveStore({times: store.times});
  }
}, true);
updateProgress();

/* ---------------- Alarms ---------------- */
const activeAlarms = Object.assign({}, store.alarms); // idx -> "HH:MM", restored from storage
if('Notification' in window && Notification.permission === 'default'){
  // permission requested lazily on first alarm set, not on load
}
function fireAlarm(label){
  if('Notification' in window && Notification.permission === 'granted'){
    new Notification('রুটিন রিমাইন্ডার', {body: label, tag: 'routine-alarm'});
  } else {
    alert('⏰ সময় হয়েছে: ' + label);
  }
}
timelineEl.addEventListener('click', e=>{
  const btn = e.target.closest('.alarm-btn');
  if(!btn) return;
  const idx = btn.dataset.idx;
  const input = timelineEl.querySelector(`.alarm-input[data-idx="${idx}"]`);
  if(!input.value){ input.focus(); return; }
  if(activeAlarms[idx]){
    delete activeAlarms[idx];
    delete store.alarms[idx];
    saveStore({alarms: store.alarms});
    btn.classList.remove('set');
    btn.lastChild.textContent = 'অ্যালার্ম সেট করুন';
    return;
  }
  if('Notification' in window && Notification.permission === 'default'){
    Notification.requestPermission();
  }
  activeAlarms[idx] = input.value;
  store.alarms[idx] = input.value;
  saveStore({alarms: store.alarms});
  btn.classList.add('set');
  btn.lastChild.textContent = `সেট: ${input.value}`;
});
setInterval(()=>{
  const now = new Date();
  const hh = String(now.getHours()).padStart(2,'0');
  const mm = String(now.getMinutes()).padStart(2,'0');
  const current = `${hh}:${mm}`;
  Object.keys(activeAlarms).forEach(idx=>{
    if(activeAlarms[idx] === current){
      fireAlarm(TIMELINE[idx].title);
      delete activeAlarms[idx];
      delete store.alarms[idx];
      saveStore({alarms: store.alarms});
      const btn = timelineEl.querySelector(`.alarm-btn[data-idx="${idx}"]`);
      if(btn){ btn.classList.remove('set'); btn.lastChild.textContent = 'অ্যালার্ম সেট করুন'; }
    }
  });
}, 15000);

/* ---------------- Legend filter ---------------- */
document.getElementById('legend').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  document.querySelectorAll('#legend button').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  const cat = btn.dataset.cat;
  document.querySelectorAll('.t-item').forEach(it=>{
    it.dataset.hide = (cat!=='all' && it.dataset.cat!==cat) ? '1' : '0';
  });
});

/* ---------------- Weekly tab ---------------- */
const dayPicker = document.getElementById('dayPicker');
const dayDetail = document.getElementById('dayDetail');
function renderDay(idx){
  const d = WEEK[idx];
  dayDetail.innerHTML = `
    <h3>${d.full}${d.off ? ' · অফলাইন দিন' : ''}</h3>
    <div class="day-row">
      <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/></svg></div>
      <div class="txt"><b>বিসিএস ফোকাস</b><span>${d.subject}</span></div>
    </div>
    <div class="day-row online">
      <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></div>
      <div class="txt"><b>অনলাইন স্লট</b><span>${d.online}</span></div>
    </div>`;
}
WEEK.forEach((d,i)=>{
  const b = document.createElement('button');
  if(d.off) b.classList.add('off-day');
  if(i===0) b.classList.add('on');
  b.innerHTML = `${d.short}<span>${d.off?'অফ':'পড়া'}</span>`;
  b.addEventListener('click', ()=>{
    dayPicker.querySelectorAll('button').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    renderDay(i);
  });
  dayPicker.appendChild(b);
});
renderDay(0);

/* ---------------- Tracker table ---------------- */
const tt = document.getElementById('trackerTable');
let thead = '<tr><th>অভ্যাস</th>' + WEEK.map(d=>`<th>${d.short}</th>`).join('') + '</tr>';
let rows = HABITS.map((h,hi)=>`<tr><td>${h}</td>${WEEK.map((d,di)=>{
  const key = hi+'-'+di;
  const checked = store.tracker[key] ? 'checked' : '';
  return `<td><input type="checkbox" data-key="${key}" ${checked}></td>`;
}).join('')}</tr>`).join('');
tt.innerHTML = thead + rows;
tt.addEventListener('change', e=>{
  if(e.target.type === 'checkbox'){
    store.tracker[e.target.dataset.key] = e.target.checked;
    saveStore({tracker: store.tracker});
  }
});

/* ---------------- Bottom nav ---------------- */
document.getElementById('bottomnav').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  document.querySelectorAll('.bottomnav button').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
  window.scrollTo({top:0, behavior:'instant'});
});
/* ---------------- Install as app (PWA) ---------------- */
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  });
}
let deferredInstallPrompt = null;
const installBtn = document.getElementById('installBtn');
window.addEventListener('beforeinstallprompt', (e)=>{
  e.preventDefault();
  deferredInstallPrompt = e;
  if(installBtn) installBtn.style.display = 'flex';
});
if(installBtn){
  installBtn.addEventListener('click', async ()=>{
    if(!deferredInstallPrompt) return;
    deferredInstallPrompt.prompt();
    await deferredInstallPrompt.userChoice;
    deferredInstallPrompt = null;
    installBtn.style.display = 'none';
  });
}
window.addEventListener('appinstalled', ()=>{
  if(installBtn) installBtn.style.display = 'none';
});
</script>

</body>
</html>
